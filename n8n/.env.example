# Copy to n8n/.env (git-ignored) and fill in. Never commit the real file.

# Shared HMAC secret. Must equal N8N_WEBHOOK_SECRET on the Convex deployment.
# Generate one with: openssl rand -hex 32
LENDLOOP_WEBHOOK_SECRET=

# Your Convex deployment's HTTP Actions URL (ends in .convex.site),
# e.g. https://happy-otter-123.convex.site
CONVEX_SITE_URL=

# Path Convex signs for the notification webhook (the pathname of
# N8N_REQUEST_WEBHOOK_URL). Leave as is unless you rename the webhook.
LENDLOOP_REQUEST_WEBHOOK_PATH=/webhook/lendloop-loan-events

# "log" (default) prints notifications to the n8n log as a mock channel.
# "smtp" sends real email through the "LendLoop SMTP" credential.
NOTIFY_CHANNEL=log
NOTIFY_FROM_EMAIL=lendloop@example.com

# Encrypts credentials stored in n8n. Generate once and keep it.
N8N_ENCRYPTION_KEY=
