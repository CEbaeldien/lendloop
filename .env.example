# ── Next.js (.env.local, git-ignored) ─────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=            # written by `npx convex dev`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Clerk dashboard → API keys
CLERK_SECRET_KEY=                  # Clerk dashboard → API keys (server only)

# ── Convex deployment env (set with `npx convex env set NAME value`) ───────
# These live on the Convex deployment, not in this file:
#   CLERK_JWT_ISSUER_DOMAIN   Clerk "convex" JWT template issuer, e.g. https://xyz.clerk.accounts.dev
#   ADMIN_EMAILS              comma-separated emails that become admins on first sign-in
#   N8N_REQUEST_WEBHOOK_URL   e.g. http://localhost:5678/webhook/lendloop-loan-events
#   N8N_WEBHOOK_SECRET        same value as LENDLOOP_WEBHOOK_SECRET in n8n/.env
